# MODELO SEM CREDENCIAIS. Não registre valores reais no Git ou no plugin.
TRANSPARENCIA_OPENAPI_MODE=offline
# TRANSPARENCIA_API_KEY=(secret no ambiente, não aqui)
# MCP_ACCESS_TOKEN=(gerar aleatoriamente, minimo 32 caracteres, armazenar em cofre)
MCP_PUBLIC_URL=http://127.0.0.1:3000/mcp
HOST=127.0.0.1
PORT=3000
MCP_ALLOWED_ORIGINS=

# Vercel: OAuth substitui o Bearer estático no endpoint remoto.
# MCP_PUBLIC_URL=https://portal-transparencia-mcp.vercel.app/mcp
# OAUTH_ISSUER=https://SEU-TENANT.auth0.com/
# OAUTH_JWKS_URL=https://SEU-TENANT.auth0.com/.well-known/jwks.json
# OAUTH_OWNER_SUB=(identificador do usuário proprietário no Auth0)
